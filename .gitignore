# ============================================================
# Python virtual environment
# ============================================================

# Local Python virtual environment.
# It contains packages and executables specific to the developer's machine.
.venv/


# ============================================================
# Python cache and compiled files
# ============================================================

# Bytecode generated by Python.
__pycache__/
*.py[cod]


# ============================================================
# Test and coverage files
# ============================================================

# Pytest cache.
.pytest_cache/

# Coverage reports.
.coverage
htmlcov/


# ============================================================
# Build and distribution files
# ============================================================

# Packages and files generated when building the project.
build/
dist/
*.egg-info/


# ============================================================
# IDE / editor files
# ============================================================

# Local editor configuration is intentionally kept out of Git.
# The project's .vscode/settings.json may be committed if we want
# to share the workspace configuration with other developers.
# .vscode/


# ============================================================
# Operating system files
# ============================================================

# Files generated by the operating system.
.DS_Store
Thumbs.db